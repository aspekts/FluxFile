# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fluxfile"

# Redis (Railway or local)
# Railway: Add Redis plugin and copy the REDIS_URL from Railway dashboard
# Local: Use redis://localhost:6379
REDIS_URL="redis://localhost:6379"


# Cloudflare R2 (same as web)
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="your_access_key"
R2_SECRET_ACCESS_KEY="your_secret_key"
R2_BUCKET_NAME="fluxfile"

# Worker Configuration
WORKER_CONCURRENCY_AUDIO="5"
WORKER_CONCURRENCY_VIDEO="2"
WORKER_CONCURRENCY_DOCUMENT="5"
WORKER_CONCURRENCY_IMAGE="20"
WORKER_ID="worker-01"

# Monitoring (Optional)
SENTRY_DSN="https://xxx@sentry.io/xxx"
NODE_ENV="development"
