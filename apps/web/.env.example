# Database
DATABASE_URL="postgresql://user:password@localhost:5432/fluxfile"

# Redis (Railway or local)
# Railway: Add Redis plugin and copy the REDIS_URL from Railway dashboard
# Local: Use redis://localhost:6379
REDIS_URL="redis://localhost:6379"


# Cloudflare R2
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="your_access_key"
R2_SECRET_ACCESS_KEY="your_secret_key"
R2_BUCKET_NAME="fluxfile"
R2_PUBLIC_URL="https://files.fluxfile.aspekts.dev"
R2_PUBLIC_DOMAIN="files.fluxfile.aspekts.dev"

# BetterAuth
BETTER_AUTH_SECRET="generate_random_32_char_string_here"
BETTER_AUTH_URL="http://localhost:3000"

# Resend (Email)
RESEND_API_KEY="re_xxxxxxxxxx"
RESEND_FROM_EMAIL="noreply@fluxfile.aspekts.dev"

# Stripe
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxxxxxxxxx"

# Monitoring (Optional)
SENTRY_DSN="https://xxx@sentry.io/xxx"
AXIOM_DATASET="fluxfile-logs"
AXIOM_TOKEN="xaat-xxxxxxxxxx"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
